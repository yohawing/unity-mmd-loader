    "local-editmode": {"explicitPolicy": "any", "description": "Local scripts/unity-tests.ps1 -Platform EditMode. Every [Explicit] skip is admitted by run state."},
    "local-playmode": {"explicitPolicy": "none", "description": "Local scripts/unity-tests.ps1 -Platform PlayMode. PlayMode accepts no skips."},
    "lts-editmode": {"explicitPolicy": "none", "description": "scripts/unity-lts-compatibility-gate.ps1 on the clean LTS consumer project."}
